{
    "manifest_version": 3,
    "name": "Browser Event Monitor",
    "version": "1.0.0",
    "permissions": ["tabs", "webNavigation", "windows", "storage", "alarms"],
    "host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
  }